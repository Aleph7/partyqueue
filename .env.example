# Firebase Web App Configuration (Leave blank to run in Demo / LocalStorage mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# YouTube Data API v3 Key (Optional: Direct YouTube link paste works via oEmbed without a key)
VITE_YOUTUBE_API_KEY=

# Host 4-digit PIN (Default: 0000)
VITE_HOST_PIN=0000
