rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // Guests and Hosts sign in via Firebase Anonymous Auth (zero sign-up friction)
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll([
          'isPlaying',
          'sortMode',
          'requestsLocked',
          'maxPerUser',
          'currentTrack'
        ])
        && request.resource.data.sortMode in ['fifo', 'votes']
        && request.resource.data.maxPerUser is int
        && request.resource.data.maxPerUser >= 1
        && request.resource.data.maxPerUser <= 20;

      match /queue/{trackId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.videoId is string
          && request.resource.data.title is string
          && request.resource.data.requestedBy is string
          && request.resource.data.guestId is string
          && request.resource.data.status == 'queued'
          && request.resource.data.votes == 1;
        allow update: if request.auth != null
          && request.resource.data.status in ['queued', 'playing', 'played', 'skipped'];
        allow delete: if request.auth != null;
      }
    }
  }
}
