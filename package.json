{
  "name": "partyqueue",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time Party Jukebox web application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh-pages": "tsc && vite build --base=/partyqueue/ && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^1.82.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
